{
  "name": "awesome-page-design",
  "version": "0.1.0",
  "description": "A layout-aware web UI skill for visual direction, existing-project integration, polished components, and responsive quality checks.",
  "license": "MIT",
  "type": "commonjs",
  "skills": "./skills/",
  "files": [
    ".codex-plugin/",
    "catalog/",
    "scripts/",
    "skills/",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "previews": "node scripts/generate-previews.js",
    "docs": "node scripts/sync-catalog-docs.js",
    "preview:serve": "node scripts/serve-preview.js",
    "test": "node --test scripts/*.test.js",
    "validate": "node scripts/validate-previews.js",
    "check": "npm test && npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuschzzp/awesome-page-design.git"
  },
  "keywords": [
    "codex-skill",
    "web-design",
    "existing-project",
    "frontend-integration",
    "style-guide",
    "visual-styles",
    "layout-guidance",
    "design-system",
    "accessibility",
    "ui"
  ],
  "engines": {
    "node": ">=18"
  }
}
